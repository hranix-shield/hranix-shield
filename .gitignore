# --- Python ---
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Локальный build-venv Windows-сборки (шаг windows-build.yml, повторённый
# вручную на Windows-машине разработки — см. отчёт-приёмка-windows-2026-09-19)
/build-venv/

# --- Env / секреты ---
.env
.env.local
.env.staging
.env.production
*.pem
*.key
infra/deploy/certs/

# --- Данные и runtime-артефакты (локальные, не редистрибутим) ---
data/*
!data/.gitkeep
*.db
*.db-journal
*.sqlite3
logs/
*.log

# Dev-restic-репозиторий бэкапов: по умолчанию .env.example ведёт его в
# infra/backups — репозиторий (снапшоты, индекс, ключи) не редистрибутив,
# коммитить нельзя (см. аудит-2026-09-19 §8.1).
infra/backups/*
!infra/backups/.gitkeep

# --- Локальные модели (LLM/ASR/TTS/эмбеддинги — качаются скриптом) ---
models/
server/models/

# --- Вектор-индекс (пересобираемый) ---
data/vector/
qdrant_storage/

# --- Rust / Tauri (клиенты) ---
clients/**/target/
clients/**/node_modules/
clients/**/dist/
clients/**/.tauri/

# --- Нативные установщики (A-20..A-22): собранные бинарники, не коммитим ---
# Собираются локально из packaging/*/*.spec + server/requirements-packaged.txt
# (см. packaging/macos/README.md) — большие бинарные артефакты, не исходники.
packaging/*/build/
packaging/*/dist/
# A-22: packaging/linux/build-deb.sh's staging tree (assembled from the
# already-ignored dist/ bundle + the tracked debian/ scripts) — same
# "rebuildable artifact, not a source file" reasoning as build/ and dist/.
packaging/linux/deb-staging/
# A-24/A-25: vendored osquery binary + Wazuh agent MSI + their extraction
# scratch space, downloaded and unpacked from the official releases by each
# OS's vendor-osquery.sh (macOS/Linux) / windows-build.yml (Windows) — a
# rebuildable, large, binary artifact pinned by version/URL/sha256 IN the
# tracked build scripts themselves, same "artifact not source" reasoning as
# dist/build/ above, not committed for the same reason those aren't.
packaging/*/vendor/
# A-62: собранный selftest-инсталлятор (packaging/windows/test/
# run-a62-selftest.sh) — rebuildable artifact, не исходник; шаблон
# packaging/*/dist/ выше не покрывает вложенный test/dist/.
packaging/windows/test/dist/

# --- IDE / OS ---
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- GUI-прогон: скриншоты тестирования (не редистрибутив) ---
gui-test-screenshots/

# Секреты: бэкапы .env от ручных/автоматических мерджей (bootstrap A-60)
.env.bak-*
