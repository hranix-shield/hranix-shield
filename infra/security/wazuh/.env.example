# A-16: variables docker-compose.yml itself needs AT container startup (the
# Wazuh manager image configures its own REST API user from these — see
# ../docker-compose.yml's header comment). Different from the platform's own
# repo-root .env.example: THAT file's WAZUH_API_USERNAME/WAZUH_API_PASSWORD
# are what this server process uses to log INTO the API below — the two
# should normally hold the SAME values.
#
#   cp infra/security/wazuh/.env.example infra/security/wazuh/.env
#   # edit WAZUH_API_PASSWORD below, then:
#   docker compose -f infra/security/wazuh/docker-compose.yml up -d

WAZUH_API_USERNAME=wazuh-wui

# REQUIRED -- docker-compose.yml fails to start (loud error, not a silent
# insecure default) if this is left empty, same "no hardcoded secret baked
# into AGPL/GPL source" principle as JWT_SECRET/RESTIC_PASSWORD in the
# platform's own .env.example. The Wazuh manager image itself enforces a
# complexity policy on this value: at least 8 characters, with upper-case,
# lower-case, a digit, and a symbol -- a weak password is REJECTED at
# container startup, not silently accepted.
WAZUH_API_PASSWORD=CHANGE_ME_Correct-Horse-9
