# Minimal Ubuntu 22.04 + real systemd as PID 1, for A-22's "install-test in
# a clean container with real systemctl" DoD attempt — see
# packaging/linux/README.md's "Проверка" section for what this can and
# cannot prove (a test container is still not a real host — same
# architectural boundary as the product's own Docker deployment).
FROM ubuntu:22.04
ENV container=docker
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
# Units that fail/hang in a container with no real hardware/udev — masking
# them is the standard workaround documented across multiple
# "systemd-in-docker" write-ups, not specific to this project.
RUN systemctl mask systemd-udev-trigger.service systemd-udevd.service \
        systemd-modules-load.service sys-kernel-config.mount \
        systemd-firstboot.service || true
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
