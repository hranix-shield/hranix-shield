# ============================================================
# AI-Assistant — шаблон конфигурации платформы
# Скопируйте в .env и настройте. НЕ коммитить .env.
# ВАЖНО: без inline-комментариев в строке значения — pydantic-settings
# включит "# ..." в само значение (особенно опасно для секретов).
# ============================================================

# --- Профиль развёртывания ---
# development | production
ENVIRONMENT=development
# single_box  (всё на ноутбуке пользователя, Вариант A плана)
# server      (выделенный сервер + тонкие клиенты, Вариант B плана)
DEPLOYMENT_PROFILE=single_box

# --- Сервер ---
# localhost по умолчанию (SECURITY.md); LAN — осознанный opt-in, менять вручную
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log

# --- Инференс LLM (портируемый рантайм; см. §3–4 плана) ---
# ollama | llamacpp | mlx   (mlx — только Apple Silicon, ускоритель)
INFERENCE_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=gemma4:e4b
# A-7 (Фаза 0): абстракция InferenceBackend/OllamaBackend заложена, но ничем
# не вызывается — ИИ выключен визуально и функционально на этой фазе.
AI_ENABLED=False
# MLX-путь (Mac): нативный аудио-вход Gemma 3n; на не-Mac игнорируется
MLX_MODEL=mlx-community/gemma-4-e4b-it-qat-OptiQ-4bit
MLX_NATIVE_AUDIO=False

# --- ASR (на не-Mac — отдельный шаг, см. §4.2 плана) ---
# whispercpp | gemma_native
ASR_BACKEND=whispercpp
WHISPER_MODEL=large-v3

# --- TTS (Silero/Kokoro/Piper — все OSI) ---
TTS_ENABLED=True

# --- RAG (Фаза 2 плана) ---
# вектор: Фаза 2 — sqlite-vec или ранний Postgres (§4.5-ревизия); Фаза 3+ — pgvector
EMBEDDING_MODEL=bge-m3           # многоязычные эмбеддинги (ru/en/...)

# --- СУБД (ревизия §4.5 от 2026-07-10, перенумеровано 2026-07-14: SQLite на Фазах 0–2, PostgreSQL с Фазы 3) ---
# слой SQLAlchemy+Alembic один — переход на Postgres сменой URL
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db
# Фаза 3+: postgresql+asyncpg://assistant:CHANGE_ME@localhost:5432/assistant
DB_MAINTENANCE_SCHEDULE=weekly   # обслуживание/целостность

# --- MCP-шина (расширения/коннекторы; §2.1 плана) ---
# путь к реестру включённых MCP-серверов
MCP_REGISTRY=infra/deploy/mcp.registry.json

# --- Безопасность ---
# Не обязателен: если пусто, сервер сам сгенерирует случайный секрет при первом
# запуске и сохранит его в data/.jwt_secret (вне git, права 600) — переживает
# рестарты. Задайте явно, только если нужен свой секрет (напр. общий на кластер).
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600
AUTH_REQUIRED=False
WS_AUTH_ENABLED=False
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Локализация (RU/EN, см. аналитический план §0.2; UI — Фаза 0, задача A-10) ---
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en

# --- Bootstrap первого администратора (A-3) ---
# Публичной регистрации нет (single-tenant панель). Если таблица users пуста
# при старте — сервер создаст ОДНОГО администратора из этих переменных.
# Оставьте пустыми после первого запуска (значения не перечитываются повторно,
# пока в таблице users есть хотя бы одна запись).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Бэкапы (A-12: restic — файл SQLite; см. §7 аналитического плана) ---
# True по умолчанию (изменено при докеризации, см. docs/инструкция-проверка-
# hranix-shield-docker-2026-07-16.md): «бэкапы работают из коробки» — реальное
# продуктовое обещание §7 плана, отчёт задачи A-12 прямо рекомендовал этот
# дефолт для конечного дистрибутива. Для чистого чек-аута разработки (venv,
# не Docker) поставьте False вручную — тесты сами не читают этот файл и не
# зависят от его значения.
BACKUP_ENABLED=True
BACKUP_DIR=infra/backups
BACKUP_SCHEDULE_HOUR=4
BACKUP_SCHEDULE_MINUTE=0
# Пароль шифрования репозитория restic. Не обязателен: если пусто, сервер
# сам сгенерирует случайный пароль при первом запуске и сохранит его в
# data/.restic_password (вне git, права 600) — тот же принцип, что JWT_SECRET.
RESTIC_PASSWORD=

# --- Каналы оповещений (A-13: §5.4 аналитического плана) ---
# Тихие часы: подавляют НЕкритические оповещения (health.changed, backup.status).
# security.alert всегда критичен и доходит несмотря на тихие часы.
QUIET_HOURS_ENABLED=True
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00
# Критическое оповещение, не подтверждённое за это время — попытка эскалации
# по каналу 6 (СМС/звонок). Канал 6 не реализован в Фазе 0 (нужен
# телефон-терминал из бэклога, §9.1) — попытка логируется как явный no-op.
NOTIFICATIONS_ESCALATION_MINUTES=15
NOTIFICATIONS_ESCALATION_CHECK_INTERVAL_SECONDS=60
# Доверенные лица (эскалации + канал 5/почта) — email через запятую.
TRUSTED_CONTACT_EMAILS=
# Канал 5 (почта) — реальный SMTP (stdlib smtplib). Не обязателен: если
# SMTP_HOST/SMTP_FROM пусты, канал почты просто недоступен (логируется
# понятно) — это чужой внешний сервис, дефолта у него нет, в отличие от
# JWT_SECRET/RESTIC_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Обнаружение вторжений (A-11: CrowdSec — MIT, единственный инструмент из
# §6.1, подключённый в этой задаче; Osquery/Wazuh/ClamAV — не в этой задаче) ---
# CrowdSec поднимается ОТДЕЛЬНО, в Docker (infra/security/crowdsec/docker-compose.yml),
# не встроен в жизненный цикл этого приложения — тот же принцип, что restic/SMTP
# выше. Не обязателен: если пусто, консоль «Обнаружение вторжений» честно
# показывает статус "не подключено", а не выдуманные нули.
# URL совпадает с портом из docker-compose (127.0.0.1:8089 -> контейнер:8080).
# Верно для venv-режима (сервер на голом хосте). Если сам Hranix Shield
# тоже в Docker (корневой docker-compose.yml) — 127.0.0.1 внутри ЕГО
# контейнера не видит хост, значение переопределяется прямо в
# docker-compose.yml на `http://hranix-crowdsec:8080` (по имени контейнера
# в общей сети `hranix-security-net`) — найдено и исправлено живьём
# 2026-07-16, см. docker-compose.yml. Здесь оставлено venv-совместимым.
CROWDSEC_LAPI_URL=http://127.0.0.1:8089
# Получить ключ бэунсера после старта контейнера:
#   docker compose -f infra/security/crowdsec/docker-compose.yml exec crowdsec \
#     cscli bouncers add hranix-shield-bouncer -o raw
CROWDSEC_API_KEY=

# A-29: ВТОРОЙ, отдельный набор учётных данных — machine-уровня LAPI-логин.
# Bouncer-ключ выше в принципе НЕ МОЖЕТ банить/разбанивать (решение самого
# CrowdSec, подтверждено живьём — см. crowdsec.py's "A-29 addendum") —
# нужен этот, отдельный credential, чтобы «Забанить вручную»/«Разбанить IP»
# на консоли «Обнаружение вторжений» реально работали. Пароль генерируется
# случайно (та же дисциплина, что у JWT_SECRET/RESTIC_PASSWORD, A-19),
# никогда не вписывайте фиксированную строку. Полный порядок действий —
# infra/security/crowdsec/README.md.
#   MACHINE_PASSWORD=$(python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#   docker compose -f infra/security/crowdsec/docker-compose.yml exec crowdsec \
#     cscli machines add hranix-shield-machine --password "$MACHINE_PASSWORD" -f -
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=

# --- Вирусная активность (A-17: ClamAV/clamd — GPLv2, сигнатурный сканер) ---
# ClamAV поднимается ОТДЕЛЬНО, в Docker (infra/security/clamav/docker-compose.yml),
# не встроен в жизненный цикл этого приложения — тот же принцип, что restic/
# CrowdSec выше. Выключено по умолчанию (тот же принцип, что BACKUP_ENABLED/
# AI_ENABLED) — явный opt-in, прежде чем сервер начнёт пытаться связаться с
# clamd по сети; см. docker-compose.yml для решения по freshclam
# (автообновление баз тоже выключено по умолчанию, отдельно от этого флага).
CLAMAV_ENABLED=False
# Совпадает с портом из docker-compose (127.0.0.1:3310 -> контейнер:3310).
# Тот же нюанс, что у CROWDSEC_LAPI_URL выше: верно для venv-режима;
# в Docker-режиме переопределяется на `hranix-clamav` в docker-compose.yml.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Журналы ОС (A-16: Wazuh Manager — GPLv2, FIM/журнал целостности файлов) ---
# Wazuh поднимается ОТДЕЛЬНО, в Docker (infra/security/wazuh/docker-compose.yml,
# manager-only — без indexer/dashboard, см. header-комментарий того файла),
# не встроен в жизненный цикл этого приложения — тот же принцип, что restic/
# CrowdSec/ClamAV выше. Не обязателен: если пусто, консоль «Журналы ОС»
# честно показывает "не подключено", а не выдуманные нули.
# URL/порт совпадают с docker-compose (127.0.0.1:55000 -> контейнер:55000);
# TLS у API-контейнера отключён (см. infra/security/wazuh/config/api.yaml),
# поэтому обычный http://, без verify=False на стороне коннектора.
# Тот же нюанс, что у CROWDSEC_LAPI_URL/CLAMAV_HOST выше: верно для
# venv-режима; в Docker-режиме переопределяется на `hranix-wazuh-manager`
# в docker-compose.yml.
WAZUH_API_URL=http://127.0.0.1:55000
# Логин/пароль API-пользователя Wazuh — задаются ПРИ СТАРТЕ контейнера через
# infra/security/wazuh/.env (см. infra/security/wazuh/.env.example для
# требований к сложности пароля, которые проверяет сам образ). Здесь должны
# быть ТЕ ЖЕ значения, чтобы этот сервер мог аутентифицироваться.
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=

# --- Сеть: гео + репутация узла (A-40) ---
# Офлайн IP -> страна для консоли «Сеть» (services/mcp/security_connectors/
# geoip.py) — sapics/ip-location-db's "user-country", Public Domain
# Dedication and Licence v1.0 (см. geoip.py's docstring для полного
# лицензионного разбора: сознательно НЕ MaxMind GeoLite2 — та требует
# регистрации аккаунта, шаг, который этот проект не делает от имени
# пользователя без его участия). Не обязателен: если пусто, geoip.py сам
# ищет вшитую при сборке копию (packaging/<os>/vendor/geoip/, см.
# packaging/<os>/vendor-geoip.sh) — если и её нет, консоль честно
# показывает `country: null` в каждой строке, а не выдуманный код страны.
# Укажите здесь путь только если скачали ту же (или альтернативную) базу
# вручную и хотите её использовать без пересборки установщика.
GEOIP_DATABASE_DIR=
